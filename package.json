{
  "name": "github-better-csv-diff",
  "version": "0.4.0",
  "description": "Browser extension that renders CSV file diffs as side-by-side tables on GitHub",
  "author": "letconst",
  "license": "MIT",
  "homepage": "https://github.com/letconst/github-better-csv-diff",
  "repository": {
    "type": "git",
    "url": "https://github.com/letconst/github-better-csv-diff.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "browser:chrome": "start \"\" \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --remote-debugging-port=9222 --user-data-dir=\"%LOCALAPPDATA%\\github-better-csv-diff\\chrome-profile\"",
    "browser:firefox": "start \"\" \"C:\\Program Files\\Mozilla Firefox\\firefox.exe\" -no-remote -profile \"%LOCALAPPDATA%\\github-better-csv-diff\\firefox-profile\\firefox_devtools_mcp_profile\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/papaparse": "^5.5.2",
    "@wxt-dev/auto-icons": "^1.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "wxt": "^0.21.4"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "diff": "^9.0.0",
    "papaparse": "^5.7.0"
  }
}
